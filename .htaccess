# Drop this into the theme folder for hint, but the REAL caching belongs in
# the site root .htaccess. Copy the contents below into <site>/.htaccess
# (between the BEGIN/END WordPress block markers is fine, just outside).
#
# Without these headers, PageSpeed will dock points for "uses long cache TTL".

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Fonts
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"

  # Images
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"

  # CSS / JS — long cache, bust via ?v= query string
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"

  # HTML — short, public (CDN can revalidate)
  ExpiresByType text/html                 "access plus 5 minutes"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2?|avif|webp|jpe?g|png|svg|ico|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset ETag
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Disable directory listing
Options -Indexes
